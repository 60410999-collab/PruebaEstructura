#include <iostream>
#include <string>
using namespace std;
 
// ================== NODOS (como en la PPT S09) ==================
struct NodoUnidad {                 // para listaUnidades y listaAtencion
    string codigo, tipo;
    NodoUnidad* siguiente;
    NodoUnidad(string c, string t) { codigo = c; tipo = t; siguiente = NULL; }
};
 
struct NodoEstado {                 // para la PILA de historial
    string estado, fecha;
    NodoEstado* siguiente;
    NodoEstado(string e, string f) { estado = e; fecha = f; siguiente = NULL; }
};
 
struct NodoEmergencia {             // para la COLA de pendientes
    string tipo, ubicacion;
    NodoEmergencia* siguiente;
    NodoEmergencia(string t, string u) { tipo = t; ubicacion = u; siguiente = NULL; }
};
 
// ================== VARIABLES DEL SISTEMA ==================
NodoUnidad* listaUnidades = NULL;   int totalUnidades = 0;   // unidades libres
NodoUnidad* listaAtencion = NULL;   int totalAtencion = 0;   // unidades ocupadas
NodoEstado* tope = NULL;            int totalEstados = 0;    // pila (maximo 100)
NodoEmergencia* frente = NULL;
NodoEmergencia* final = NULL;       int totalCola = 0;       // cola (maximo 5)
 
// ================== FUNCIONES AUXILIARES ==================
string leer(string mensaje) {
    string s;
    cout << mensaje;
    getline(cin, s);
    return s;
}
 
NodoUnidad* buscar(NodoUnidad* lista, string codigo) {
    for (NodoUnidad* p = lista; p != NULL; p = p->siguiente)
        if (p->codigo == codigo) return p;
    return NULL;
}

void insertarAlFinal(NodoUnidad*& lista, NodoUnidad* nodo) {
    nodo->siguiente = NULL;
    if (lista == NULL) {
