    string fecha  = leer("Fecha: ");
    if (totalEstados == 100) {
        cout << "Historial lleno\n";
        return;
    }
    NodoEstado* nuevo = new NodoEstado(estado, fecha);
    nuevo->siguiente = tope;           // el nuevo apunta al que estaba arriba
