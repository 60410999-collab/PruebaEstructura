// ================== 4. PILA: revertir ultimo estado (desapilar) ==================
void revertirEstado() {
    if (tope == NULL) {
        cout << "No hay estados para revertir\n";
        return;
    }
    cout << "Estado revertido: " << tope->estado << endl;
    NodoEstado* borrar = tope;
    tope = tope->siguiente;
    delete borrar;
    totalEstados--;
    cout << "Se revirtio el estado\n";
}
 
// ================== 5. COLA: agregar emergencia (encolar) ==================
void agregarEmergencia() {
    string tipo      = leer("Tipo de emergencia: ");
    string ubicacion = leer("Ubicacion: ");
    if (totalCola == 5) {
        cout << "Cola llena\n";
        return;
    }
    NodoEmergencia* nuevo = new NodoEmergencia(tipo, ubicacion);
    if (frente == NULL) frente = nuevo;        // cola vacia
    else final->siguiente = nuevo;             // se une al final
    final = nuevo;
    totalCola++;
    cout << "Emergencia en espera\n";
}
 
// ================== 6. COLA: asignar unidad a la siguiente emergencia (desencolar) ==================
